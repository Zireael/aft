[package]
name = "aft-test-fake-lsp-server"
version = "0.0.0"
edition = "2021"
publish = false

# An isolated, small build avoids linking all of AFT into the protocol fixture.
[workspace]

[[bin]]
name = "fake-lsp-server"
path = "main.rs"

[dependencies]
serde = { version = "1", features = ["derive"] }
serde_json = "1"
url = "2"

[target.'cfg(unix)'.dependencies]
libc = "0.2"

[profile.dev]
debug = 0
